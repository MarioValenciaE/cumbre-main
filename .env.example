# Copy to .env (git-ignored) or export in your shell. Never commit real values.
# The research engine reads these from the environment only.

# --- Company research providers (all optional; paid use also needs --allow-paid + --provider-cap) ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- Where confidential client material lives (default: <repo>/clients, git-ignored) ---
# CUMBRE_CLIENTS_DIR=~/Cumbre-Private/clients
